# -----------------------------------------------------------------------------
# Smart Battery AI - Environment Configuration Example
# -----------------------------------------------------------------------------

# Backend API Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./data/battery_charging.db
# Cloud Deployment (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_battery_db

# Machine Learning Service Configuration
ML_MODEL_PATH=ml/artifacts/unplug_predictor.joblib
FALLBACK_BUFFER_MINUTES=30
BATTERY_HEALTH_MAX_LIMIT_PCT=80
