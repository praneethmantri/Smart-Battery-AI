# =============================================================================
# Python & ML
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.joblib
*.pkl
*.onnx
*.pt
*.pth

# Exceptions: Pre-trained production ML models & keepfiles required for backend out-of-the-box
!ml/models/*.joblib
!ml/models/*.json
!ml/artifacts/.gitkeep

# =============================================================================
# Environments & Configs
# =============================================================================
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.env
.env.local
*.log

