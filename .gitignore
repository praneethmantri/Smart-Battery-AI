# Databases & Local Runtime Data
# =============================================================================
*.sqlite3
*.db
data/raw/
data/processed/
data/telemetry_local.db
!data/raw/.gitkeep
!data/processed/.gitkeep

# =============================================================================
# Node & Frontend
# =============================================================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

